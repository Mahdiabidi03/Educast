# ─────────────────────────────────────────────────────────────────────────────
# AI Service — environment variables template
# • Local dev (GPU)  → copy to .env         (use requirements.txt + CUDA torch)
# • Docker (CPU)     → copy to .env.docker  (use requirements-docker.txt)
# Never commit .env or .env.docker with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# GPU memory management (local GPU dev only; remove in Docker/CPU mode)
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ── NestJS backend ────────────────────────────────────────────────────────────
# Local: http://localhost:3000 | Docker: http://backend:3000
NESTJS_BACKEND_URL=http://localhost:3000

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=educast

# ── MLflow tracking ───────────────────────────────────────────────────────────
# Local: http://localhost:5000 | Docker: http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=Summary Evaluation

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
# Local: http://localhost:11434 | Docker: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Mistral ───────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Hugging Face ──────────────────────────────────────────────────────────────
HF_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_TOKEN=
